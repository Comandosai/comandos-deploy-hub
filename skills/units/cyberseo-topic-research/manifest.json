{
  "bundle_id": "cyberseo-topic-research",
  "bundle_name": "Поиск и импорт тем CyberSEO",
  "version": "0.1.0",
  "clients": ["antigravity", "claude", "codex", "gemini", "terminal"],
  "required_inputs": [
    "client_api_state",
    "main_topic",
    "country",
    "topic_count"
  ],
  "optional_inputs": [
    "city",
    "blog_description",
    "about_blog",
    "firecrawl_api_key",
    "perplexity_api_key"
  ],
  "modules": [
    "config-read",
    "queue-and-published-read",
    "topic-research",
    "dedupe",
    "import-rows-build",
    "queue-batch-import"
  ]
}

