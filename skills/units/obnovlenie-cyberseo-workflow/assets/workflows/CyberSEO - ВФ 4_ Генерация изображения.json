    {
      "parameters": {
        "jsCode": "const MAX_ATTEMPTS = 20;\n\nconst state = $getWorkflowStaticData('node');\n\nif (!state.statusFailCount) {\n  state.statusFailCount = 0;\n}\n\nstate.statusFailCount += 1;\n\nif (state.statusFailCount >= MAX_ATTEMPTS) {\n  state.statusFailCount = 0;\n  throw new Error(\n    `❌ Статус не изменился после ${MAX_ATTEMPTS} попыток. KIE AI не отвечает или завис. Workflow остановлен.`\n  );\n}\n\n// Пропускаем ВСЕ данные насквозь без изменений\nreturn $input.all().map(item => ({ json: item.json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        608
      ],
      "id": "fb8e3bdf-d911-49d7-91a4-95dc2fddbe4f",
      "name": "Счетчик 10"
    },
    {
      "parameters": {
        "jsCode": "const MAX_ATTEMPTS = 5;\n\nconst state = $getWorkflowStaticData('node');\n\nif (!state.failCount) {\n  state.failCount = 0;\n}\n\nstate.failCount += 1;\n\nif (state.failCount >= MAX_ATTEMPTS) {\n  state.failCount = 0;\n  throw new Error(\n    `❌ Генерация провалилась ${MAX_ATTEMPTS} раза. Проверь баланс в KIE AI.`\n  );\n}\n\n// Пропускаем ВСЕ данные насквозь без изменений\nreturn $input.all().map(item => ({ json: item.json }));"
      },
