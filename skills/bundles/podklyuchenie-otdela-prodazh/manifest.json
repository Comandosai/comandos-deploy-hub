{
  "bundle_id": "podklyuchenie-otdela-prodazh",
  "bundle_name": "Подключение отдела продаж",
  "version": "0.2.0",
  "clients": ["antigravity", "claude", "codex", "terminal"],
  "workflow_artifact": {
    "name": "sales-workflows",
    "url": "https://api.comandos.ai/skill-runtime/artifacts/sales-workflows/latest",
    "auth_header": "X-License-Key"
  },
  "required_inputs": [
    "x-license-key"
  ],
  "optional_inputs": [
    "supabase_server_access",
    "supabase_service_role_key",
    "n8n_server_access",
    "db_host",
    "db_port",
    "db_name",
    "db_user",
    "db_password",
    "db_schema",
    "openrouter_api_key",
    "openai_api_key",
    "telegram_sales_bot_token",
    "telegram_error_bot_token"
  ],
  "modules": [
    "infra-discovery",
    "workflow-import",
    "credentials-setup",
    "mcp-setup",
    "test-agent-setup",
    "telegram-testing"
  ]
}
