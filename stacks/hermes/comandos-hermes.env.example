# COMANDOS Hermes installer config
# Скопируйте этот файл в comandos-hermes.env и заполните значения.

# --- VPS access ---
# Заполните один удобный вариант доступа.
#
# Вариант 1: готовая SSH-команда или alias из ~/.ssh/config.
# Пример: SSH_CONNECT_COMMAND="ssh my-vps"
SSH_CONNECT_COMMAND=
SSH_HOST_ALIAS=

# Вариант 2: IP + SSH-ключ.
VPS_IP=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# Вариант 3: root-пароль.
ROOT_USER=root
ROOT_PASSWORD=

# Обычно можно оставить пустым: установщик сам выберет ssh_config, key или password.
SSH_AUTH_METHOD=

# --- Public panel address ---
# Если домен есть, заполните DOMAIN. Если домена нет, оставьте пустым:
# будет использован https://VPS_IP.nip.io
DOMAIN=

# --- COMANDOS license ---
# Пользователь вводит лицензионный ключ уже при входе в панель.
# В локальный файл развёртывания ключ не кладём.
COMANDOS_LICENSE_SERVER_URL=https://api.comandos.ai/v1/license/products
COMANDOS_LICENSE_SESSION_DAYS=14

# --- Model keys ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MINIMAX_API_KEY=

# Модель по умолчанию. Если оставить пустым, установщик выберет сам:
# MiniMax -> DeepSeek -> OpenAI -> Qwen по заполненным ключам.
# Можно явно задать, например:
# DEFAULT_PROVIDER=minimax
# DEFAULT_MODEL=MiniMax-M2.7
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# --- Telegram wrapper ---
# Необязательно для первого запуска панели.
# Если оба поля пустые, Telegram-роутер не ставится.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_USER_ID=

# Необязательно: второй Telegram-бот на том же Hermes.
# TELEGRAM_BOT_TOKEN_SECOND=
# TELEGRAM_BOT_USERNAME_SECOND=

# Необязательно: дополнительные Telegram ID через запятую.
# TELEGRAM_ALLOWED_USERS=

# Голосовые сообщения в Telegram.
HERMES_STT_ENABLED=true
HERMES_STT_MODEL=base
HERMES_STT_LANGUAGE=ru
HERMES_TIMEOUT_SECONDS=240
HERMES_POLL_TIMEOUT_SECONDS=10
HERMES_SHOW_PROFILE_IN_RESPONSE=false

# --- Ports ---
WORKSPACE_PORT=3030
HERMES_GATEWAY_PORT=8642

# --- Weak VPS safety ---
# На слабом VPS установщик сам добавит swap для сборки панели.
# Можно выключить: COMANDOS_CREATE_SWAP=0
COMANDOS_CREATE_SWAP=auto
COMANDOS_SWAP_SIZE=2G
COMANDOS_SWAP_FILE=/swapfile-comandos-hermes

# --- Install paths on VPS ---
REMOTE_APP_USER=hermes
REMOTE_BASE_DIR=/opt/comandos/hermes
REMOTE_WORKSPACE_DIR=/opt/comandos/hermes/workspace
REMOTE_HERMES_HOME=/home/hermes/.hermes

# --- Managed updates ---
# Обычно менять не нужно. Панель раз в загрузку проверяет этот manifest
# и показывает кнопку обновления, если версия в GitHub стала новее.
COMANDOS_STACK_REPO_URL=https://github.com/Comandosai/comandos-deploy-hub.git
COMANDOS_STACK_REF=main
COMANDOS_STACK_PATH=stacks/hermes
COMANDOS_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Comandosai/comandos-deploy-hub/main/stacks/hermes/update-manifest.json
# На время проверки можно оставить 60000: панель проверяет обновления раз в минуту.
VITE_UPDATE_CHECK_INTERVAL_MS=60000

# --- Generated by installer; leave empty ---
HERMES_PASSWORD=
