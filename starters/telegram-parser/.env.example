# API Telegram уже задан внутри проекта.
# Эти поля нужны только если надо заменить его на свой.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Имя локальной Telegram-сессии. Можно не менять.
TELEGRAM_SESSION_NAME=parser
SESSIONS_DIR=sessions

# Файл со списком каналов и групп.
SOURCES_FILE=sources.txt

# Куда сохранять данные.
OUTPUT_DIR=data

# Сколько последних сообщений забирать из каждого источника.
HISTORY_LIMIT=500

# Скачивать ли медиа. Для первого урока лучше оставить false.
DOWNLOAD_MEDIA=false

# DeepSeek необязателен. Без него сбор данных всё равно работает.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
