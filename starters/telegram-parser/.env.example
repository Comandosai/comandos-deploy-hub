# Получите API ID и API Hash в https://my.telegram.org.
# Реальные значения храните только в локальном .env.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Имя локальной Telegram-сессии. Можно не менять.
TELEGRAM_SESSION_NAME=parser
SESSIONS_DIR=sessions

# Файл со списком каналов и групп.
SOURCES_FILE=sources.txt

# Куда сохранять данные.
OUTPUT_DIR=data

# Сколько последних сообщений забирать из каждого источника.
HISTORY_LIMIT=500

# Скачивать ли медиа. Для первого урока лучше оставить false.
DOWNLOAD_MEDIA=false

# Превращать скачанные документы в Markdown через MarkItDown.
# Работает только если DOWNLOAD_MEDIA=true.
EXTRACT_MARKDOWN=false
MARKDOWN_OUTPUT_DIR=data/analysis/markitdown

# DeepSeek необязателен. Без него сбор данных всё равно работает.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Уведомления и отчёты через своего Telegram-бота.
# TELEGRAM_BOT_TOKEN берётся у @BotFather.
# TELEGRAM_NOTIFY_CHAT_IDS — один или несколько chat_id через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_IDS=
TELEGRAM_BOT_PARSE_MODE=HTML
